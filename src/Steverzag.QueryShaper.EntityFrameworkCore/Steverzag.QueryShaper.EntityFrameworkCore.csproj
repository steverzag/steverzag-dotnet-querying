<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Description>EF Core add-on for Steverzag.QueryShaper: async pagination (ApplyPagedAsync, PaginateAsync), provider member filters, and decimal math on SQLite.</Description>
    <PackageTags>linq;iqueryable;filtering;sorting;pagination;entity-framework-core;efcore</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Steverzag.QueryShaper\Steverzag.QueryShaper.csproj" />
  </ItemGroup>

  <!-- See src/Directory.Build.targets. -->
  <PropertyGroup>
    <PinnedReference>Steverzag.QueryShaper</PinnedReference>
    <PinnedMinVersion>0.1.0-preview</PinnedMinVersion>
    <PinnedUpperBound>0.2.0-a</PinnedUpperBound>
  </PropertyGroup>

</Project>
