<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Description>Filter, order, paginate, group and map IQueryable&lt;T&gt; from a request described as data, such as a JSON body bound to QueryRequest. Fields are named with Steverzag.PropertySelectors, and the result stays one translatable query.</Description>
    <PackageTags>linq;iqueryable;filtering;sorting;pagination;query;dynamic-query;entity-framework-core</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.10" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Steverzag.PropertySelectors\Steverzag.PropertySelectors.csproj" />
  </ItemGroup>

  <!-- See src/Directory.Build.targets. -->
  <PropertyGroup>
    <PinnedReference>Steverzag.PropertySelectors</PinnedReference>
    <PinnedMinVersion>0.1.0-preview</PinnedMinVersion>
    <PinnedUpperBound>0.2.0-0</PinnedUpperBound>
  </PropertyGroup>

</Project>
